{
  "fonts": [
    "system-ui",
    "-apple-system",
    "Segoe UI",
    "Roboto",
    "Noto Sans",
    "Noto Sans Tamil",
    "Noto Sans Devanagari",
    "Nirmala UI",
    "ui-monospace",
    "Cascadia Mono",
    "SF Mono",
    "Menlo",
    "Consolas"
  ],
  "fontSizes": [12, 14, 16, 18, 22, 28],
  "typeRules": [
    { "selector": "h1", "sizes": [28] },
    { "selector": "h2", "sizes": [14, 18] },
    { "selector": "h3", "sizes": [16, 18] },
    { "selector": "button, [role=button]", "sizes": [14, 16] }
  ],
  "minControlSize": 24,
  "controlSizeRules": [],
  "minControlGap": 8,
  "minControlInset": 8,
  "controlContainers": ["[data-ui-container]"],
  "minLayoutGap": 8,
  "bannedCopy": ["unlock your potential", "seamlessly", "game-changing"],
  "viewports": [
    { "width": 390, "height": 844 },
    { "width": 1440, "height": 900 }
  ],
  "colorSchemes": ["light", "dark"],
  "exceptions": [
    {
      "rules": ["content-clipping"],
      "selector": "span[role=\"tooltip\"].sr-only",
      "reason": "Visually-hidden tooltip names for icon buttons; text is intentionally 1px-clipped by the standard sr-only pattern and exposed to assistive tech via aria-describedby."
    }
  ]
}
